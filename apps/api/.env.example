# Copia questo file in .env e adatta i valori.

# In sviluppo il database è un PostgreSQL "embedded" avviato da `npm run db:dev`
# (porta 54329). La password viene usata anche per inizializzarlo la prima volta.
DATABASE_URL="postgresql://alby:CAMBIAMI@127.0.0.1:54329/cartelle"

HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Cookie "Secure" (solo HTTPS). Di default è attivo in produzione.
# COOKIE_SECURE=true

# Da attivare se l'app sta dietro un reverse proxy (nginx, Caddy, Traefik).
TRUST_PROXY=false

# Durata della sessione (si rinnova a ogni utilizzo).
SESSION_TTL_DAYS=30

# In produzione: cartella con la build della webapp da servire.
# WEB_DIST=../web/dist
