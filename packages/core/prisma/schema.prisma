generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEDICO
  PAZIENTE
}

enum Sex {
  M
  F
  X
}

/// Account che possono accedere all'applicazione.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  displayName        String
  passwordHash       String
  role               Role
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions      Session[]
  patientAccess PatientAccess[]
  auditLogs     AuditLog[]
  reports       Report[]
  files         StoredFile[]
  studies       ImagingStudy[]
  medications   Medication[]

  @@map("users")
}

/// Sessioni attive. L'id è l'hash SHA-256 del token: il token in chiaro non viene mai salvato.
model Session {
  id         String   @id
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id         String    @id @default(uuid()) @db.Uuid
  firstName  String
  lastName   String
  birthDate  DateTime? @db.Date
  sex        Sex?
  fiscalCode String?   @unique
  bloodType  String?
  phone      String?
  email      String?
  notes      String?
  /// Nome, cognome e codice fiscale in minuscolo e senza accenti, per la ricerca.
  searchText String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  access  PatientAccess[]
  reports     Report[]
  files       StoredFile[]
  studies     ImagingStudy[]
  medications Medication[]

  @@index([lastName, firstName])
  @@map("patients")
}

/// Tipo di referto deciso dagli amministratori: un nome e l'elenco dei campi da compilare.
model ReportTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  /// Spiegazione breve, mostrata quando si sceglie il tipo.
  description String?
  /// Elenco dei campi: [{ key, type, label, required, ocr_enabled, hint, options }].
  fields      Json
  /// Ordine nell'elenco dei tipi.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("report_templates")
}

enum ReportKind {
  /// Analisi con valori (sangue, urine…): tabella di risultati.
  LABORATORIO
  /// Referto a testo libero (risonanza, TAC, ecografia, visita specialistica…).
  DESCRITTIVO
}

/// File caricati (per ora i PDF dei referti). Il contenuto sta nel database: un solo posto da salvare.
model StoredFile {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  size        Int
  /// Impronta del contenuto: riconosce lo stesso PDF caricato due volte.
  sha256      String
  data        Bytes
  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  report Report?

  @@unique([patientId, sha256])
  @@map("files")
}

/// Un referto: esami di laboratorio oppure referto descrittivo.
model Report {
  id            String      @id @default(uuid()) @db.Uuid
  patientId     String      @db.Uuid
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind          ReportKind
  title         String
  examDate      DateTime    @db.Date
  /// Analisi di laboratorio: giorno del prelievo del campione.
  samplingDate  DateTime?   @db.Date
  reportDate    DateTime?   @db.Date
  reportNumber  String?
  facility      String?
  doctor        String?
  doctorRole    String?
  body          String?
  notes         String?
  /// PDF originale da cui è stato importato (se c'è).
  fileId        String?     @unique @db.Uuid
  file          StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  /// Quale estrattore ha letto il PDF (e quale versione): utile se un formato viene letto male.
  parserId      String?
  parserVersion Int?
  createdById   String?     @db.Uuid
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  results LabResult[]
  /// Studi di immagini (TAC, risonanza…) a cui questo referto si riferisce.
  studies ImagingStudy[]

  @@index([patientId, examDate])
  @@map("reports")
}

/// Un valore di un esame di laboratorio.
model LabResult {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @db.Uuid
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  position       Int
  section        String?
  name           String
  /// Valore come scritto nel referto ("13,8", "< 0,5", "Negativo").
  value          String
  /// Valore numerico, quando il risultato è un numero (per grafici e confronti).
  numericValue   Float?
  unit           String?
  referenceRange String?
  outOfRange     Boolean?

  @@index([reportId, position])
  @@index([name])
  @@map("lab_results")
}

/// Quali pazienti può vedere (ed eventualmente modificare) un utente non amministratore.
model PatientAccess {
  userId    String   @db.Uuid
  patientId String   @db.Uuid
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([userId, patientId])
  @@index([patientId])
  @@map("patient_access")
}

/// Registro di accessi e modifiche (GDPR).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

/// Studio di diagnostica per immagini (una TAC, una risonanza…), di solito importato da un CD.
model ImagingStudy {
  id              String    @id @default(uuid()) @db.Uuid
  patientId       String    @db.Uuid
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// Identificativo DICOM dello studio (StudyInstanceUID).
  studyUid        String
  studyDate       DateTime? @db.Date
  description     String?
  modalities      String[]
  institution     String?
  accessionNumber String?
  /// Referto testuale collegato a queste immagini (scelto dall'utente; stesso paziente).
  reportId        String?   @db.Uuid
  report          Report?   @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdById     String?   @db.Uuid
  createdBy       User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  series ImagingSeries[]

  @@unique([patientId, studyUid])
  @@index([patientId, studyDate])
  @@index([reportId])
  @@map("imaging_studies")
}

model ImagingSeries {
  id          String       @id @default(uuid()) @db.Uuid
  studyId     String       @db.Uuid
  study       ImagingStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  /// SeriesInstanceUID
  seriesUid   String
  number      Int?
  modality    String?
  description String?

  instances ImagingInstance[]

  @@unique([studyId, seriesUid])
  @@map("imaging_series")
}

/// Una singola immagine: il file DICOM originale è salvato così com'è nella cartella di archivio.
model ImagingInstance {
  id             String        @id @default(uuid()) @db.Uuid
  seriesId       String        @db.Uuid
  series         ImagingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  /// SOPInstanceUID: identifica l'immagine (la stessa immagine caricata due volte non si duplica).
  sopUid         String
  instanceNumber Int?
  size           Int
  sha256         String
  /// Percorso relativo alla cartella di archivio (STORAGE_DIR).
  storagePath    String
  createdAt      DateTime      @default(now())

  @@unique([seriesId, sopUid])
  @@index([seriesId, instanceNumber])
  @@map("imaging_instances")
}

/// Un farmaco che il paziente assume o ha assunto (terapia in corso o conclusa).
model Medication {
  id               String    @id @default(uuid()) @db.Uuid
  patientId        String    @db.Uuid
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// Nome del farmaco come sulla confezione ("Cardioaspirin 100 mg").
  name             String
  activeIngredient String?
  /// Codice AIC della confezione, se scelta dall'elenco AIFA.
  aic              String?
  /// Dosaggio della confezione: quanto principio attivo contiene ("500 mg", "120 mg/5 ml").
  strength         String?
  /// Formulazione ("Compressa", "Sciroppo", "Gocce orali").
  form             String?
  /// Quanto ne prende ("1 compressa", "20 gocce").
  dosage           String?
  /// Quando ("mattina e sera", "ogni 8 ore").
  frequency        String?
  /// Solo al bisogno (antidolorifici, ansiolitici…).
  asNeeded         Boolean   @default(false)
  /// Perché lo prende ("pressione alta").
  reason           String?
  prescriber       String?
  startDate        DateTime? @db.Date
  /// Data di fine: vuota = terapia in corso.
  endDate          DateTime? @db.Date
  notes            String?
  createdById      String?   @db.Uuid
  createdBy        User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId, endDate])
  @@map("medications")
}

/// Elenco dei farmaci autorizzati in Italia: dati aperti AIFA (licenza CC BY 4.0), una riga per confezione.
/// Serve solo a cercare i farmaci per nome o principio attivo; si aggiorna con `npm run farmaci:importa`.
model DrugPackage {
  aic              String   @id
  name             String
  package          String?
  activeIngredient String?
  holder           String?
  form             String?
  atc              String?
  /// "Autorizzata", "Revocata", "Sospesa"…
  status           String?
  supply           String?
  /// Foglietto illustrativo sul sito AIFA.
  leafletUrl       String?
  /// Nome, confezione e principio attivo in minuscolo e senza accenti, per la ricerca.
  searchText       String
  importedAt       DateTime @default(now())

  @@index([name])
  /// Indice a trigrammi (estensione pg_trgm, attivata nella migrazione): parole dentro il testo e somiglianza.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("drug_packages")
}

/// Impostazioni del server modificabili dagli amministratori: una riga per voce.
/// Le voci assenti valgono il valore predefinito (vedi `settings.ts`).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Prestazioni specialistiche ambulatoriali del Servizio sanitario della Regione Puglia: una riga per voce del
/// Catalogo Unico Regionale (file pubblici del portale SIST), con tariffa e branche dal Nomenclatore tariffario.
/// Si aggiorna dall'app (pagina Prestazioni, come amministratore) o con `npm run prestazioni:importa`.
model HealthService {
  /// Codice regionale numerico; con il suffisso "-c" per la voce cessata del vecchio nomenclatore che lo condivide.
  id                   String    @id
  /// Codice Regionale Numerico del catalogo.
  regionalCode         String
  /// Codice del nomenclatore in vigore (DPCM LEA 2017), es. "89.13". Vuoto per le voci cessate.
  code                 String?
  nomenclatureName     String?
  /// Codice Regionale Alfanumerico (DPCM 2017), es. "89.13.00.01".
  alphaCode            String?
  /// Codice, denominazione e codice alfanumerico del vecchio nomenclatore (DPCM LEA 1996), se la voce esisteva.
  oldCode              String?
  oldNomenclatureName  String?
  oldAlphaCode         String?
  /// Denominazione estesa del catalogo.
  name                 String
  standardName         String?
  shortName            String?
  /// Colonna "Attiva" del catalogo (S/N); vuota per le voci ancora da attivare.
  active               Boolean?
  validFrom            DateTime? @db.Date
  validFromRef         String?
  /// Data di fine validità: se c'è, la voce è cessata.
  validTo              DateTime? @db.Date
  validToRef           String?
  notes                String?
  /// "P" = solo primo accesso, "C" = solo controllo.
  accessType           String?
  /// Dal Nomenclatore tariffario (per codice del nomenclatore): assenti se il codice non vi compare.
  tariff               Decimal?  @db.Decimal(10, 2)
  therapeuticCycle     Boolean?
  /// In ordine alfabetico.
  branches             String[]
  /// Le branche come testo ("NEUROCHIRURGIA, NEUROLOGIA"), per ordinare l'elenco; vuoto se non ce ne sono.
  branchText           String?
  /// "NAZIONALE DPCM2017" oppure "REGIONALE NO LAR" (prestazione aggiunta dalla Regione).
  tariffList           String?
  /// Codici e denominazioni in minuscolo e senza accenti, per la ricerca.
  searchText           String

  @@index([code])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("health_services")
}

/// Da quali file viene il catalogo delle prestazioni in uso (una sola riga).
model HealthServiceImport {
  id            Int      @id @default(1)
  catalogSource String
  tariffSource  String?
  importedAt    DateTime @default(now())

  @@map("health_service_imports")
}
