generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEDICO
  PAZIENTE
}

enum Sex {
  M
  F
  X
}

/// Account che possono accedere all'applicazione.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  displayName        String
  passwordHash       String
  role               Role
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions      Session[]
  patientAccess PatientAccess[]
  auditLogs     AuditLog[]

  @@map("users")
}

/// Sessioni attive. L'id è l'hash SHA-256 del token: il token in chiaro non viene mai salvato.
model Session {
  id         String   @id
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id         String    @id @default(uuid()) @db.Uuid
  firstName  String
  lastName   String
  birthDate  DateTime? @db.Date
  sex        Sex?
  fiscalCode String?   @unique
  bloodType  String?
  phone      String?
  email      String?
  notes      String?
  /// Nome, cognome e codice fiscale in minuscolo e senza accenti, per la ricerca.
  searchText String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  access PatientAccess[]

  @@index([lastName, firstName])
  @@map("patients")
}

/// Quali pazienti può vedere (ed eventualmente modificare) un utente non amministratore.
model PatientAccess {
  userId    String   @db.Uuid
  patientId String   @db.Uuid
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([userId, patientId])
  @@index([patientId])
  @@map("patient_access")
}

/// Registro di accessi e modifiche (GDPR).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
