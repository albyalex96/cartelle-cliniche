{
  "name": "@alby/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:start": "tsx scripts/dev-db.ts start",
    "db:stop": "tsx scripts/dev-db.ts stop",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "farmaci:importa": "tsx scripts/import-farmaci.ts",
    "prestazioni:importa": "tsx scripts/import-prestazioni.ts"
  },
  "dependencies": {
    "@alby/dicom": "*",
    "@alby/pdf": "*",
    "@alby/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.1.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15"
  }
}
