# Copia questo file in .env (nella cartella principale) e adatta i valori. Il file .env non va in git.

# In sviluppo il database è un PostgreSQL "embedded" avviato da `npm run dev` (porta 54329).
# La password viene usata anche per inizializzarlo la prima volta: scegline una casuale.
DATABASE_URL="postgresql://alby:CAMBIAMI@127.0.0.1:54329/cartelle"

# Una sessione inutilizzata per questo numero di giorni scade...
SESSION_IDLE_DAYS=30
# ...e comunque dopo questo numero di giorni dal login bisogna rientrare.
SESSION_MAX_DAYS=90

# Solo in produzione dietro un reverse proxy fidato: considera X-Forwarded-For per l'IP del client.
# TRUST_PROXY=true

# Cookie solo su HTTPS (di default attivo in produzione).
# COOKIE_SECURE=true
