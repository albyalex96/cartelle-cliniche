# Copia questo file in .env (nella cartella principale) e adatta i valori. Il file .env non va in git.

# In sviluppo il database è un PostgreSQL "embedded" avviato da `npm run dev` (porta 54329).
# La password viene usata anche per inizializzarlo la prima volta: scegline una casuale.
DATABASE_URL="postgresql://alby:CAMBIAMI@127.0.0.1:54329/cartelle"

# Durata delle sessioni: sono i valori predefiniti, un amministratore può cambiarli dalla pagina Impostazioni.
# Una sessione inutilizzata per questo numero di giorni scade...
SESSION_IDLE_DAYS=30
# ...e comunque dopo questo numero di giorni dal login bisogna rientrare.
SESSION_MAX_DAYS=90

# Solo in produzione dietro un reverse proxy fidato: considera X-Forwarded-For per l'IP del client.
# TRUST_PROXY=true

# Cookie solo su HTTPS (di default attivo in produzione).
# COOKIE_SECURE=true

# Cartella delle immagini DICOM caricate dai CD (di default .data/storage, esclusa da git).
# Va salvata nei backup insieme al database.
# STORAGE_DIR=/percorso/archivio

# Riconoscimento del testo nei PDF scansionati (OCR). Avviene SEMPRE in locale: nessun servizio esterno,
# nessun download. Con "false" (predefinito) l'app si comporta come prima: per le scansioni chiede di
# compilare a mano. Il risultato va sempre rivisto: l'OCR può sbagliare virgole e unità di misura.
# OCR_ENABLED=true
# "wasm" (predefinito, nessuna installazione: va bene su Windows) oppure "native" (programma tesseract
# del sistema: più veloce, usato nell'immagine Docker).
# OCR_ENGINE=wasm
# Oltre questo numero di pagine la scansione non viene letta; tempo massimo per pagina in secondi.
# OCR_MAX_PAGES=10
# OCR_PAGE_TIMEOUT_SECONDS=60

# Chiave (almeno 32 caratteri) che cifra i segreti della verifica in due passaggi.
# Generala con: openssl rand -base64 32. Non cambiarla: i codici smetterebbero di funzionare.
# TWO_FACTOR_KEY=

# Indirizzo pubblico HTTPS della webapp, necessario alle passkey (non può essere un indirizzo IP).
# APP_URL=https://cartelle.esempio.it
