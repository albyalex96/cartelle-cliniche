{
  "name": "alby-cartelle-cliniche",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run db:start && npm run dev -w @alby/web",
    "db:start": "npm run db:start -w @alby/core",
    "db:stop": "npm run db:stop -w @alby/core",
    "db:migrate": "npm run db:migrate -w @alby/core",
    "db:generate": "npm run db:generate -w @alby/core",
    "build": "npm run db:generate && npm run build -w @alby/web",
    "start": "npm run start -w @alby/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @alby/core && npm run test -w @alby/pdf && npm run test -w @alby/dicom",
    "pdf:anonimizza": "npm run anonimizza -w @alby/pdf --",
    "pdf:estrai": "npm run estrai -w @alby/pdf --",
    "farmaci:importa": "npm run farmaci:importa -w @alby/core --"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
