{
  "name": "alby-cartelle-cliniche",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n db,api,web -c blue,green,magenta \"npm run db:dev -w @alby/api\" \"npm run dev -w @alby/api\" \"npm run dev -w @alby/web\"",
    "db:dev": "npm run db:dev -w @alby/api",
    "db:migrate": "npm run db:migrate -w @alby/api",
    "db:generate": "npm run db:generate -w @alby/api",
    "build": "npm run build -w @alby/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
